# meminbox reads ONLY MEMINBOX_-prefixed settings, so it never picks up an
# app's SUPABASE_URL / OPENAI_API_KEY from your shell or a project's .env.
# `meminbox init` writes these to ~/.meminbox/.env (mode 0600).

# --- Supabase (your own project; use a DEDICATED project for memory) ---
# Project Settings > API
MEMINBOX_SUPABASE_URL=https://your-project.supabase.co
# Server-side only. Never expose this to browsers or commit it.
# The MCP server / CLI run on your machine, so the service role key stays local.
MEMINBOX_SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings (optional) ---
# Without this, search falls back to full-text only and everything still works.
# Model changes require a full reindex: embeddings are a derived index, not the source of truth.
# The schema stores 1536-dimension vectors; any OpenAI text-embedding-3 model works.
MEMINBOX_OPENAI_API_KEY=
MEMINBOX_EMBEDDING_MODEL=text-embedding-3-small
# Model used by `extract` to turn transcripts into inbox candidates.
MEMINBOX_EXTRACT_MODEL=gpt-4o-mini

# --- Defaults ---
# Project slug used when a write does not name one.
MEMINBOX_DEFAULT_PROJECT=default
# Actor name recorded in provenance / audit log for this process (e.g. claude-code, codex, cursor).
MEMINBOX_ACTOR=cli
