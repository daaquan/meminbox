node_modules/
# dist/ is committed on purpose: it lets `npm install -g github:daaquan/meminbox`
# work without a build step (npm's git-dependency `prepare` runs before the
# devDependency binaries are usable, so building at install time is unreliable).
# Only the runtime .js files are tracked; maps and type declarations are not.
dist/**/*.js.map
dist/**/*.d.ts
.env
.env.*
!.env.example
*.log
.DS_Store

# Supabase CLI local state
supabase/.temp/

# Supabase CLI per-checkout scaffolding, generated by `supabase init`.
# Each checkout has its own; the repo ships only supabase/migrations/.
supabase/config.toml
supabase/.gitignore
